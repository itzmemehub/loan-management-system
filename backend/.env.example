PORT=5000
MONGODB_USERNAME=your-mongodb-username
MONGODB_PASSWORD=your-mongodb-password
MONGODB_URI=your-mongodb-atlas-connection-string
JWT_SECRET=replace-with-a-long-random-secret
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-this-password

# Frontend address(es) allowed to call the API with the admin session cookie.
# Comma separated. Local default: http://localhost:5173
CLIENT_ORIGIN=http://localhost:5173
# lax when the frontend proxies /api (recommended); none if the frontend and
# API are on different sites (needs HTTPS; Safari blocks it).
COOKIE_SAMESITE=lax
# Set to production when deployed; makes the session cookie HTTPS-only.
NODE_ENV=development
